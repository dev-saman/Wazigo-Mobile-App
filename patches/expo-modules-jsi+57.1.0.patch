+
+/// Value-typed counterpart to ``NonisolatedUnsafeVar`` for carrying non-Sendable values across an
+/// isolation boundary without the class's heap allocation. Bypasses Swift's concurrency checking, so
+/// it is only sound for values the caller knows are confined to a single synchronous scope.
+internal struct UncheckedSendableBox<Value>: @unchecked Sendable {
+  let value: Value
+
+  init(_ value: Value) {
+    self.value = value
+  }
+}
