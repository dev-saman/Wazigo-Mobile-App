# Copy to .env and adjust. Everything prefixed EXPO_PUBLIC_ is bundled into the app
# and readable by anyone with the app binary - never put secrets here.

EXPO_PUBLIC_API_BASE_URL=https://app.wazigo.io/api/v1

# Laravel Reverb needs NO configuration here. Since 2026-09-18 the socket key,
# host, port and scheme arrive from GET /me/bootstrap (data.realtime) at runtime.

# Login code length. Must match the backend OTP setting (default 5 digits).
EXPO_PUBLIC_OTP_LENGTH=5
